{
  "name": "earguard",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android:patch-gradle-plugin": "node scripts/patchGradlePlugin.js",
    "android:patch-metro": "node scripts/patchMetroKeyHandlers.js",
    "android:patch": "pnpm android:patch-gradle-plugin && pnpm android:patch-metro",
    "build:prepare": "node scripts/prepareBuild.js",
    "run": "pnpm android",
    "dev": "pnpm start",
    "android": "bash scripts/run-android-phone.sh",
    "android:debug": "bash scripts/run-android-phone.sh",
    "android:phone": "bash scripts/run-android-phone.sh",
    "android:release": "bash scripts/android-release-build.sh all",
    "android:apk": "bash scripts/android-release-build.sh apk",
    "android:bundle": "bash scripts/android-release-build.sh bundle",
    "android:aab": "pnpm android:bundle",
    "metro:usb": "bash scripts/adb-reverse-metro.sh",
    "android:reverse": "pnpm metro:usb",
    "ios": "pnpm build:prepare && react-native run-ios",
    "lint": "eslint .",
    "start": "bash scripts/start-metro.sh",
    "start:metro": "bash scripts/start-metro.sh",
    "test": "jest",
    "postinstall": "pnpm android:patch"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.85.3",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/codegen": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/gradle-plugin": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@react-native/typescript-config": "0.85.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">= 22.11.0"
  }
}